# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env (đã gitignore).
# Biến không có giá trị mặc định thì bắt buộc; biến có dòng "mặc định" có thể bỏ qua.

# --- Bắt buộc ---
DATABASE_URL=
JWT_SECRET=

# --- AI: Gemini (STT + chấm điểm LLM) ---
GEMINI_API_KEY=
# Tùy chọn (mặc định):
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_STT_MODEL=gemini-2.5-flash
# GEMINI_LLM_MODEL=gemini-2.5-flash

# --- AWS S3 (lưu file ghi âm) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Tùy chọn (mặc định):
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=interview-practice-audio

# --- FPT.AI TTS (đọc phản hồi, làm ở giai đoạn sau) ---
FPT_AI_API_KEY=
